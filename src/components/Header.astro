---
import { locales, ui, type LocaleCode } from '../i18n/locales';

interface Props {
  lang: LocaleCode;
  basePath: string;
  photographerName: string;
}

const { lang, basePath, photographerName } = Astro.props;
const t = ui[lang];

// Same order as the home page panels, plus Shop (no panel yet). Photo detail
// pages belong to Photography, so its link stays lit there too.
const nav = [
  {
    href: `/${lang}/photography/`,
    label: t.photography,
    active: basePath.startsWith('/photography') || basePath.startsWith('/photo/'),
  },
  { href: `/${lang}/videos/`, label: t.videos, active: basePath.startsWith('/videos') },
  { href: `/${lang}/shop/`, label: t.shop, active: basePath.startsWith('/shop') },
  { href: `/${lang}/contact/`, label: t.contactNav, active: basePath.startsWith('/contact') },
  { href: `/${lang}/about/`, label: t.about, active: basePath.startsWith('/about') },
];

const langHref = (code: string) => `/${code}${basePath === '/' ? '/' : basePath}`;
---

<header class="relative z-40 flex items-center justify-between py-6 text-[0.72rem] uppercase tracking-[0.22em] md:py-8">
  <!-- Wordmark: same size, case and tracking as the nav so the whole bar
       reads as one line; weight + the accent dot make it the logo. -->
  <a href={`/${lang}/`} class="site-logo font-bold text-ink" aria-label={photographerName}>
    {photographerName}<span class="text-accent">.</span>
  </a>

  <!-- Desktop -->
  <div class="hidden items-center gap-10 lg:flex xl:gap-12">
    <nav class="flex gap-7 xl:gap-8" aria-label="Main">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={['nav-link transition-colors duration-300 hover:text-ink', item.active ? 'is-active text-ink' : 'text-muted']}
            aria-current={item.active ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <button type="button" class="theme-toggle" data-theme-toggle aria-label="Toggle dark mode">
      ◐
    </button>

    <nav class="flex gap-3 border-l border-line pl-8" aria-label="Language">
      {
        locales.map((loc) => (
          <a
            href={langHref(loc.code)}
            class:list={[
              'transition-colors duration-300 hover:text-ink',
              loc.code === lang ? 'text-ink underline decoration-accent decoration-2 underline-offset-4' : 'text-muted',
            ]}
            aria-current={loc.code === lang ? 'true' : undefined}
            lang={loc.htmlLang}
          >
            {loc.label}
          </a>
        ))
      }
    </nav>
  </div>

  <!-- Mobile + tablet -->
  <div class="flex items-center gap-5 lg:hidden">
    <button type="button" class="theme-toggle" data-theme-toggle aria-label="Toggle dark mode">
      ◐
    </button>
    <button
      type="button"
      class="burger"
      data-menu-toggle
      aria-label="Menu"
      aria-expanded="false"
    >
      <span class="burger__line"></span>
      <span class="burger__line"></span>
    </button>
  </div>
</header>

<!-- Full-screen mobile menu -->
<div class="mobile-menu lg:hidden" data-mobile-menu aria-hidden="true">
  <nav class="flex flex-col gap-2" aria-label="Main">
    {
      nav.map((item, i) => (
        <a
          href={item.href}
          class="mobile-menu__link font-serif"
          aria-current={item.active ? 'page' : undefined}
        >
          <span class="mr-4 align-middle text-[0.7rem] uppercase tracking-[0.3em] text-muted">
            0{i + 1}
          </span>
          <span class:list={[item.active ? 'mobile-menu__link-label is-active' : 'mobile-menu__link-label']}>
            {item.label}
          </span>
        </a>
      ))
    }
  </nav>

  <div class="mobile-menu__footer">
    <nav class="flex gap-6 text-[0.78rem] uppercase tracking-[0.22em]" aria-label="Language">
      {
        locales.map((loc) => (
          <a
            href={langHref(loc.code)}
            class:list={[loc.code === lang ? 'text-ink underline decoration-accent decoration-2 underline-offset-4' : 'text-muted']}
            lang={loc.htmlLang}
          >
            {loc.label}
          </a>
        ))
      }
    </nav>
  </div>
</div>
