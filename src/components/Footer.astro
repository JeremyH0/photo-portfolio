---
import { ui, type LocaleCode } from '../i18n/locales';

interface Props {
  lang: LocaleCode;
  photographerName: string;
  /** Slim variant for the one-screen home page (nothing to scroll back up). */
  compact?: boolean;
}

const { lang, photographerName, compact = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer
  class:list={[
    'flex items-center justify-between text-[0.7rem] uppercase tracking-[0.2em] text-muted',
    compact ? 'py-6' : 'mt-24 border-t border-line py-8 md:mt-32',
  ]}
>
  <p>© {year} {photographerName}</p>
  {
    compact ? (
      <p class="hidden sm:block">{ui[lang].tagline}</p>
    ) : (
      <a href="#top" class="transition-colors duration-300 hover:text-ink" data-back-to-top>
        {ui[lang].backToTop}
      </a>
    )
  }
</footer>
