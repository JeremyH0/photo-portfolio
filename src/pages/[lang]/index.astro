---
import Layout from '../../layouts/Layout.astro';
import { getLocalePaths, ui, type LocaleCode } from '../../i18n/locales';
import { getSiteSettings } from '../../lib/queries';
import { srcsetFor, urlFor } from '../../lib/image';
import { resolveShots, type ResolvedShot, type Shot } from '../../lib/shots';
import { VIDEO_REEL } from '../../lib/site';

export function getStaticPaths() {
  return getLocalePaths();
}

const lang = Astro.params.lang as LocaleCode;
const t = ui[lang];

// The four doors into the site, in the order Nick asked for. Each plays a
// short reel of his photos (see Shot in lib/shots.ts for focus/crop), and
// each reel keeps one mood so the panels stay distinct side by side.
const PANELS: { key: string; href: string; label: string; sub: string; shots: Shot[] }[] = [
  {
    key: 'photography',
    href: `/${lang}/photography/`,
    label: t.photography,
    sub: t.photographySub,
    // Landscape, landscape, portrait, portrait, B&W. At Jeremy's request,
    // Drums Against the Mountain replaced Snow Dance and Backward Glance the
    // festival street (Summer Lantern Street).
    shots: [
      { id: 'photo-nick-81771a06158f', focus: '50% 55%' }, // Peak at First Light
      { id: 'photo-nick-a0d01672f987', focus: '55% 55%' }, // By the Lone Pine
      { id: 'photo-nick-2d30f4848014', focus: '45% 40%' }, // Drums Against the Mountain
      { id: 'photo-nick-9bf72cc30bcd', focus: '58% 66%' }, // Backward Glance
      { id: 'photo-nick-faf8ffbb90a0', focus: '50% 30%' }, // Downward Light
    ],
  },
  {
    key: 'videos',
    href: `/${lang}/videos/`,
    label: t.videos,
    sub: t.videosSub,
    shots: VIDEO_REEL,
  },
  {
    key: 'contact',
    href: `/${lang}/contact/`,
    label: t.contactNav,
    sub: t.contactSub,
    // Warm, inviting night light.
    shots: [
      // Golden Reach — only the goldfish bowl and her pointing hand: the left
      // 70% of the frame, cropped server-side so her face is never sent (it
      // starts at ~72% across).
      { id: 'photo-nick-c7ad9f26df72', focus: '78% 60%', crop: { x: 0, y: 0, w: 0.7, h: 1 } },
      { id: 'photo-nick-d11c919961dd', focus: '38% 60%' }, // Canal of Lights
      { id: 'photo-nick-7e5fddb3755a', focus: '40% 50%' }, // Yellow Bus Night
      { id: 'photo-nick-083c32a46ce5', focus: '55% 62%' }, // Frozen Lantern Light
      { id: 'photo-nick-7d017be1d27d', focus: '65% 50%' }, // Lily at Sunrise
      { id: 'photo-nick-349fe00cfbc8', focus: '45% 45%' }, // Gyoza Night Stall
    ],
  },
  {
    key: 'about',
    href: `/${lang}/about/`,
    label: t.about,
    sub: t.aboutSub,
    // Calm, cool light — scenes only, no people (no portrait of Nick exists
    // yet, and anyone pictured here reads as him).
    shots: [
      { id: 'photo-nick-8c4afd465ecb', focus: '70% 66%' }, // Winter Shrine — framed on the red roof
      { id: 'photo-nick-c1a1e7e4bf98', focus: '35% 55%' }, // Ridge Above the Clouds
      { id: 'photo-nick-418c498c137a', focus: '50% 45%' }, // Snow Threshold
      { id: 'photo-nick-db7af513ffbb', focus: '50% 50%' }, // Blue Hour Lake
      { id: 'photo-nick-cddba31aa814', focus: '55% 50%' }, // Magnolia Sky
      { id: 'photo-nick-2553360ebe5b', focus: '50% 55%' }, // Dusk Over Still Water
    ],
  },
];

const [settings, ...resolved] = await Promise.all([
  getSiteSettings(),
  ...PANELS.map((panel) => resolveShots(panel.shots)),
]);
const panels = PANELS.map((panel, i) => ({ ...panel, shots: resolved[i] }));

const pad = (n: number) => String(n).padStart(2, '0');

// Panel images are object-fit: cover inside a box that is ~70vw wide on md+
// (100vw on phones) but, on tall screens, *height* decides how wide the
// photo actually renders: a 3:2 landscape filling a 950px-tall tablet panel
// is ~1400px wide. `sizes` must describe that or the browser picks a
// too-small candidate and the photo goes soft. Heights track global.css:
// md+ panel ≈ viewport minus header/controls/footer (13rem, min 26rem);
// phones' open panel is sized by the image's own 52svh floor.
function panelSizes(shot: ResolvedShot): string {
  const aspect = (shot.width / shot.height).toFixed(3);
  return (
    `(min-width:768px) max(70vw, calc(max(26rem, 100vh - 13rem) * ${aspect})), ` +
    `max(100vw, calc(52vh * ${aspect}))`
  );
}
---

<Layout
  lang={lang}
  namespace="home"
  pageTitle={settings.photographerName}
  title={`${settings.photographerName} — ${t.tagline}`}
  photographerName={settings.photographerName}
  fill
>
  <h1 class="sr-only">{settings.photographerName}</h1>

  <!-- Expanding panels (after aaronjamieson.com's home carousel): one is
       open, the rest are slim strips. Clicking a strip opens it; clicking the
       open one enters that section. Without JS they're plain links. -->
  <section class="home-panels" data-home data-enter-label={t.enter} aria-label="Sections">
    {
      panels.map((panel, i) => (
        <a
          href={panel.href}
          class:list={['home-panel', i === 0 && 'is-active']}
          data-home-panel={panel.key}
          data-cursor-label={i === 0 ? t.enter : undefined}
          style={`background-image: url(${panel.shots[0].placeholder})`}
        >
          {/* One slide per shot. Only the first loads with the page and
              only it is rendered: the rest are `hidden` (out of rendering
              entirely — see initSlideshows() for why) and carry data-src(set)
              until the reel fetches and decodes them just ahead of their turn.
              .home-panel__zoom holds the open/hover zoom for the whole panel. */}
          <div class="home-panel__media" data-slideshow={panel.shots.length > 1 ? '' : undefined}>
            <div class="home-panel__zoom">
            {
              panel.shots.map((shot, k) => {
                const src = urlFor(shot.photo.image, 1440, undefined, shot.rect);
                const srcset = srcsetFor(shot.photo.image, undefined, shot.rect);
                return (
                  <div class:list={['reel-slide', k === 0 && 'is-current']} data-slide hidden={k > 0}>
                    <img
                      class="home-panel__img photo-img"
                      src={k === 0 ? src : undefined}
                      srcset={k === 0 ? srcset : undefined}
                      data-src={k > 0 ? src : undefined}
                      data-srcset={k > 0 ? srcset : undefined}
                      sizes={panelSizes(shot)}
                      width={shot.width}
                      height={shot.height}
                      style={`object-position: ${shot.focus}`}
                      alt=""
                      loading="eager"
                      fetchpriority={i === 0 && k === 0 ? 'high' : 'auto'}
                      decoding="async"
                    />
                  </div>
                );
              })
            }
            </div>
          </div>
          <div class="home-panel__shade" aria-hidden="true" />

          <span class="home-panel__num" aria-hidden="true">{pad(i + 1)}</span>
          <span class="home-panel__label" aria-hidden="true">{panel.label}</span>

          <div class="home-panel__content">
            {
              panel.key === 'videos' && (
                <span class="home-panel__soon">
                  <span class="videos-poster__rec" aria-hidden="true" />
                  {t.comingSoon}
                </span>
              )
            }
            <h2 class="home-panel__title">
              <span class="home-panel__line">
                <span>
                  {panel.label}
                  <span class="home-panel__dot">.</span>
                </span>
              </span>
            </h2>
            <p class="home-panel__sub">{panel.sub}</p>
            <span class="home-panel__cta">
              {t.enter}
              <span class="home-panel__cta-icon" aria-hidden="true">→</span>
            </span>
          </div>
        </a>
      ))
    }
  </section>

  <div class="home-controls" data-home-controls>
    <p class="home-counter" aria-hidden="true">
      <span class="text-ink" data-home-current>01</span>
      <span class="mx-1">/</span>
      <span>{pad(panels.length)}</span>
    </p>

    <div class="home-progress">
      {
        panels.map((panel, i) => (
          <button
            type="button"
            class="home-progress__bar"
            data-home-goto={i}
            aria-label={panel.label}
            aria-pressed={i === 0 ? 'true' : 'false'}
          />
        ))
      }
    </div>

    <div class="flex gap-3">
      <button type="button" class="home-step" data-home-step="prev" aria-label={t.prev}>←</button>
      <button type="button" class="home-step" data-home-step="next" aria-label={t.next}>→</button>
    </div>
  </div>
</Layout>
