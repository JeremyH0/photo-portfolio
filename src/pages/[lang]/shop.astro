---
import Layout from '../../layouts/Layout.astro';
import { getLocalePaths, l, ui, type LocaleCode } from '../../i18n/locales';
import { shopUi } from '../../i18n/shop';
import { getSiteSettings } from '../../lib/queries';
import { srcsetFor, urlFor } from '../../lib/image';
import { resolveShots, type ResolvedShot } from '../../lib/shots';
import { FEATURED, IDEAS, PREVIEW } from '../../lib/shop';
import { INSTAGRAM_URL } from '../../lib/site';

export function getStaticPaths() {
  return getLocalePaths();
}

const lang = Astro.params.lang as LocaleCode;
const t = ui[lang];
const s = shopUi[lang];

// "Coming soon" teaser (see src/lib/shop.ts): nothing is for sale yet.
const [[featured, ...preview], ideas, settings] = await Promise.all([
  resolveShots([FEATURED, ...PREVIEW]),
  resolveShots(IDEAS.map((idea) => idea.shot)),
  getSiteSettings(),
]);

/**
 * A photo hung on a wall: returns the frame's width (% of the wall) and the
 * photo's rendered width as a fraction of the wall, so it never outgrows the
 * wall's height whatever its shape. wallAspect = wall width / height.
 */
function hang(shot: ResolvedShot, wallAspect: number) {
  const aspect = shot.width / shot.height;
  const photo = Math.min(0.7, (0.72 / wallAspect) * aspect);
  return { frame: `${(photo * 100 + 8).toFixed(1)}%`, photo };
}
// Walls: preview grid is 3 cols from lg (≤1600px container), 2 from sm.
const cardSizes = (photo: number) =>
  `(min-width:1024px) calc(min(30vw, 500px) * ${photo.toFixed(3)}), (min-width:640px) calc(46vw * ${photo.toFixed(3)}), calc(92vw * ${photo.toFixed(3)})`;
// Idea tiles are 4:5 and cover-fitted: a landscape photo renders wider.
const tileSizes = (shot: ResolvedShot) => {
  const k = Math.max(1, 1.25 * (shot.width / shot.height)).toFixed(3);
  return `(min-width:1024px) calc(31vw * ${k}), (min-width:640px) calc(46vw * ${k}), calc(92vw * ${k})`;
};

const hero = hang(featured, 5 / 4);
---

<Layout
  lang={lang}
  namespace="shop"
  pageTitle={t.shop}
  title={`${t.shop} — ${settings.photographerName}`}
  photographerName={settings.photographerName}
>
  <section class="flex min-h-[34svh] flex-col justify-end pb-10 md:min-h-[40svh] md:pb-14" id="top">
    <p class="hero-line mb-4 text-[0.72rem] uppercase tracking-[0.24em] text-muted">{s.eyebrow}</p>
    <h1 class="hero-title font-serif text-[clamp(2.6rem,7.5vw,6.5rem)] leading-[0.98] tracking-[-0.01em]">
      <span data-split>{s.title}</span><span class="text-accent">.</span>
    </h1>
    <div class="about-reveal mt-6 flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
      <p class="max-w-xl text-base leading-relaxed text-muted md:text-lg">{s.intro}</p>
      <p class="shop-notice"><span class="shop-notice__dot" aria-hidden="true"></span>{s.notice}</p>
    </div>
  </section>

  <section class="about-reveal grid items-center gap-10 border-t border-line pt-10 md:pt-14 lg:grid-cols-12 lg:gap-16">
    <div class="shop-wall aspect-[5/4] lg:col-span-7">
      <div class="shop-frame shop-frame--large" style={`width: ${hero.frame}`}>
        <div class="photo-media" style={`background-image: url(${featured.placeholder})`}>
          <img
            class="photo-img block h-auto w-full"
            src={urlFor(featured.photo.image, 1440, undefined, featured.rect)}
            srcset={srcsetFor(featured.photo.image, undefined, featured.rect)}
            sizes={`(min-width:1024px) calc(min(55vw, 900px) * ${hero.photo.toFixed(3)}), calc(92vw * ${hero.photo.toFixed(3)})`}
            width={featured.width}
            height={featured.height}
            alt={l(featured.photo.title, lang)}
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
      <span class="shop-wall__tag">{t.comingSoon}</span>
    </div>

    <div class="lg:col-span-5">
      <p class="mb-4 text-[0.68rem] uppercase tracking-[0.3em] text-accent">{s.featureEyebrow}</p>
      <h2 class="font-serif text-[clamp(1.9rem,3.6vw,3rem)] leading-[1.1]">{s.featureTitle}</h2>
      <p class="mt-5 max-w-md leading-relaxed text-muted">{s.featureBody}</p>
    </div>
  </section>

  <section class="mt-24 md:mt-36">
    <div class="about-reveal mb-10 flex flex-col gap-3 border-t border-line pt-10 md:mb-14 md:flex-row md:items-end md:justify-between">
      <h2 class="font-serif text-[clamp(1.9rem,4.5vw,3.6rem)] leading-[1.05]">{s.previewTitle}<span class="text-accent">.</span></h2>
      <p class="max-w-md text-muted">{s.previewBody}</p>
    </div>

    <div class="grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-10">
      {
        preview.map((shot) => {
          const h = hang(shot, 4 / 5);
          return (
            <figure class="shop-reveal">
              <div class="shop-wall aspect-[4/5]">
                <div class="shop-frame" style={`width: ${h.frame}`}>
                  <div class="photo-media" style={`background-image: url(${shot.placeholder})`}>
                    <img
                      class="photo-img block h-auto w-full"
                      src={urlFor(shot.photo.image, 1080, undefined, shot.rect)}
                      srcset={srcsetFor(shot.photo.image, undefined, shot.rect)}
                      sizes={cardSizes(h.photo)}
                      width={shot.width}
                      height={shot.height}
                      alt={l(shot.photo.title, lang)}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                </div>
              </div>
              <figcaption class="mt-5 font-serif text-xl leading-snug">{l(shot.photo.title, lang)}</figcaption>
            </figure>
          );
        })
      }
    </div>
  </section>

  <section class="mt-24 md:mt-36">
    <h2 class="about-reveal mb-10 border-t border-line pt-10 font-serif text-[clamp(1.9rem,4.5vw,3.6rem)] leading-[1.05] md:mb-14">
      {s.ideasTitle}<span class="text-accent">.</span>
    </h2>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        IDEAS.map((idea, i) => {
          const shot = ideas[i];
          const copy = s.ideas[idea.key];
          return (
            <article class="shop-reveal shop-tile photo-media" style={`background-image: url(${shot.placeholder})`}>
              <img
                class="photo-img absolute inset-0 h-full w-full object-cover"
                src={urlFor(shot.photo.image, 768, undefined, shot.rect)}
                srcset={srcsetFor(shot.photo.image, undefined, shot.rect)}
                sizes={tileSizes(shot)}
                width={shot.width}
                height={shot.height}
                style={`object-position: ${shot.focus}`}
                alt=""
                loading="lazy"
                decoding="async"
              />
              <div class="shop-tile__shade" aria-hidden="true" />
              <span class="shop-tile__soon">{t.comingSoon}</span>
              <div class="shop-tile__body">
                <h3 class="font-serif text-2xl leading-tight">{copy.title}</h3>
                <p class="mt-2 text-[0.9rem] leading-relaxed opacity-85">{copy.body}</p>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <section class="about-reveal mt-24 mb-8 border-t border-line pt-12 md:mt-36 md:pt-16">
    <h2 class="font-serif text-[clamp(1.9rem,4.5vw,3.6rem)] leading-[1.1]">{s.askTitle}</h2>
    <p class="mt-4 max-w-xl text-muted md:text-lg">{s.askBody}</p>
    <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-5">
      <a class="shop-btn" href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">
        Instagram<span aria-hidden="true">↗</span>
      </a>
      <a class="shop-link" href={`/${lang}/contact/`}>
        {t.contactNav}<span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Layout>
